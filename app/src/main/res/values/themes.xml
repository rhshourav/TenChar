<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only. The window colour matches the app background, so there is
         no white flash on start and the splash screen is already on brand. -->
    <style name="Theme.TenChar" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tc_space</item>
        <item name="android:colorBackground">@color/tc_space</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>